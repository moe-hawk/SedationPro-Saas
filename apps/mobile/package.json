    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "happy-dom": "^15.11.7",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
